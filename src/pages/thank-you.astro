---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Thank You - Voise Tech" description="Thank you for contacting Voise Tech." noindex>
  <section class="thanks">
    <div class="container inner">
      <span class="badge" aria-hidden="true"><Icon name="check" size={30} stroke={2} /></span>
      <h1 class="h1">Thank You!</h1>
      <p class="lede">We will connect with you shortly.</p>
      <div class="cluster">
        <a class="btn" href="/">Back to home <Icon name="arrow" size={16} class="arrow" /></a>
        <a class="btn btn-secondary" href="/resources/case-studies/">Read our case studies</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .thanks { padding-block: clamp(96px, 14vw, 200px); background: radial-gradient(50% 60% at 50% 0%, rgb(14 177 81 / 0.08), transparent 70%); }
  .inner { display: grid; justify-items: center; text-align: center; gap: 22px; }
  .badge { width: 72px; height: 72px; border-radius: 50%; display: grid; place-items: center; color: #fff; background: var(--grad); box-shadow: 0 16px 40px -12px rgb(14 177 81 / 0.55); animation: pop 700ms var(--ease-out) both; }
  @keyframes pop { from { transform: scale(0.6); opacity: 0; } }
  .cluster { justify-content: center; margin-top: 12px; }
</style>
