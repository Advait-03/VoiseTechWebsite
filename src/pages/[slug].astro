---
/**
 * Root-level URLs, preserved from WordPress: blog posts (/how-ai-…/) and
 * product pages (/voise-ad-server/) both live at /{slug}/.
 */
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductPage from '../components/ProductPage.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ResourceCard from '../components/ResourceCard.astro';
import Icon from '../components/Icon.astro';
import Img from '../components/Img.astro';
import products from '../data/products.json';
import { SITE } from '../data/site';
import { allPosts, relatedPosts, readingTime, formatDate, postItem, type Post } from '../lib/content';

export async function getStaticPaths() {
  const posts = await allPosts();
  return [
    ...posts.map((post) => ({ params: { slug: post.id }, props: { kind: 'post' as const, post } })),
    ...products.map((product) => ({ params: { slug: product.slug }, props: { kind: 'product' as const, product } })),
  ];
}

type Props =
  | { kind: 'post'; post: Post }
  | { kind: 'product'; product: (typeof products)[number] };

const props = Astro.props as Props;
let post: Post | undefined;
let Content: any, headings: { depth: number; slug: string; text: string }[] = [], related: Post[] = [];
if (props.kind === 'post') {
  post = props.post;
  ({ Content, headings } = await render(post));
  related = await relatedPosts(post);
}
const d = post?.data;
const toc = headings.filter((h) => h.depth === 2);
const shareUrl = post ? new URL(`/${post.id}/`, SITE.url).href : '';
const schema = post ? [{
  '@type': 'BlogPosting',
  headline: d!.title,
  description: d!.description,
  datePublished: d!.date.toISOString(),
  dateModified: (d!.updated ?? d!.date).toISOString(),
  image: d!.image ? new URL(d!.image.src, SITE.url).href : undefined,
  author: { '@id': `${SITE.url}/#organization` },
  publisher: { '@id': `${SITE.url}/#organization` },
  mainEntityOfPage: shareUrl,
  keywords: d!.tags.map((t) => t.name).join(', ') || undefined,
}] : [];
---
{props.kind === 'product' ? (
  <ProductPage product={props.product} />
) : (
  <BaseLayout
    title={d!.seoTitle ?? d!.title}
    description={d!.description || d!.excerpt}
    type="article"
    image={d!.image ? { ...d!.image, alt: d!.title } : undefined}
    publishedTime={d!.date}
    modifiedTime={d!.updated}
    breadcrumbs={[{ label: 'Voise Blogs', href: '/resources/blog/' }, { label: d!.title, href: `/${post!.id}/` }]}
    schema={schema}
  >
    <div class="progress" aria-hidden="true"><span data-progress></span></div>
    <article class="post" data-progress-target>
      <header class="post-head container">
        <Breadcrumbs items={[{ label: 'Resources', href: '/resources/blog/' }, { label: 'Voise Blogs', href: '/resources/blog/' }, { label: d!.title, href: `/${post!.id}/` }]} />
        <h1 class="h1 post-title" data-reveal>{d!.title}</h1>
        <p class="post-meta mono" data-reveal style="--i:1">
          <time datetime={d!.date.toISOString()}>{formatDate(d!.date)}</time>
          <span>{readingTime(post!.body)} min read</span>
        </p>
      </header>
      {(d!.banner ?? d!.image) && (
        <div class="container banner" data-reveal="mask">
          <div class="media">
            <Img src={(d!.banner ?? d!.image)!.src} alt="" sizes="(max-width: 1280px) 100vw, 1280px" loading="eager" fetchpriority="high" />
          </div>
        </div>
      )}
      <div class="container post-grid">
        <div class="post-aside">
          {toc.length > 1 && (
            <nav class="toc" aria-label="On this page" data-section-nav>
              <p class="mono toc-title">On this page</p>
              <ol role="list">
                {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
              </ol>
            </nav>
          )}
          <div class="share">
            <p class="mono toc-title">Share</p>
            <a class="share-btn" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`} target="_blank" rel="noopener noreferrer">
              <Icon name="linkedin" size={16} /> LinkedIn<span class="sr-only"> (opens in a new tab)</span>
            </a>
          </div>
        </div>
        <div class="post-body">
          <div class="prose"><Content /></div>
          {d!.tags.length > 0 && (
            <ul role="list" class="tags" aria-label="Tags">
              {d!.tags.map((t) => <li><a class="pill" href={`/tag/${t.slug}/`}>#{t.name}</a></li>)}
            </ul>
          )}
          <div class="post-cta on-night">
            <p class="h3">Let’s Build What’s Next in Programmatic Advertising — Together.</p>
            <a class="btn" href={d!.cta?.href ?? '/contact-us/'}>{d!.cta?.label ?? 'Connect With Us Today'}<Icon name="arrow" size={16} class="arrow" /></a>
          </div>
        </div>
      </div>
    </article>

    {related.length > 0 && (
      <section class="section tone-subtle related">
        <div class="container">
          <div class="related-head">
            <h2 class="h2">Keep reading</h2>
            <a class="link-arrow" href="/resources/blog/"><span class="label">All articles</span><Icon name="arrow" size={14} class="arrow" /></a>
          </div>
          <ul role="list" class="related-grid" data-stagger>
            {related.map((r) => <li data-reveal><ResourceCard item={postItem(r)} /></li>)}
          </ul>
        </div>
      </section>
    )}
  </BaseLayout>
)}

<style>
  .progress { position: fixed; inset: 0 0 auto 0; height: 3px; z-index: 120; pointer-events: none; }
  .progress span { display: block; height: 100%; background: var(--grad); transform-origin: left; transform: scaleX(0); }
  .post-head { padding-top: clamp(40px, 6vw, 88px); display: grid; gap: 22px; }
  .post-title { max-width: 22ch; font-size: clamp(2.2rem, 1.4rem + 3.2vw, 4.25rem); }
  .post-meta { display: flex; gap: 18px; color: var(--ink-2); }
  .post-meta span::before { content: '·'; margin-right: 18px; color: var(--line-strong); }
  .banner { margin-top: clamp(32px, 4vw, 56px); }
  .banner .media { aspect-ratio: 1181 / 400; border-radius: var(--radius-l); }
  .post-grid { display: grid; grid-template-columns: 220px minmax(0, 720px); gap: clamp(32px, 6vw, 96px); padding-block: clamp(48px, 6vw, 88px) var(--section); justify-content: center; }
  .post-aside { position: sticky; top: 100px; align-self: start; display: grid; gap: 36px; }
  .toc-title { color: var(--ink-3); margin-bottom: 12px; }
  .toc ol { display: grid; gap: 2px; border-left: 1px solid var(--line); }
  .toc a { display: block; padding: 6px 0 6px 14px; margin-left: -1px; border-left: 1px solid transparent; font-size: var(--fs-xs); color: var(--ink-2); line-height: 1.45; transition: color var(--dur), border-color var(--dur); }
  .toc a:hover { color: var(--ink); }
  .toc a[aria-current] { color: var(--ink); border-left-color: var(--blue); }
  .share-btn { display: inline-flex; align-items: center; gap: 8px; height: 36px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--line-strong); font-size: var(--fs-xs); font-weight: 500; transition: background-color var(--dur), color var(--dur); }
  .share-btn:hover { background: var(--ink); color: #fff; border-color: var(--ink); }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 48px; }
  .tags a:hover { border-color: var(--ink); color: var(--ink); }
  .post-cta { margin-top: 48px; padding: clamp(28px, 4vw, 44px); border-radius: var(--radius-l); display: grid; gap: 22px; justify-items: start; background: radial-gradient(80% 120% at 100% 0%, rgb(8 112 199 / 0.45), transparent 60%), var(--night); }
  .related-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; margin-bottom: 40px; }
  .related-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  @media (max-width: 960px) {
    .post-grid { grid-template-columns: minmax(0, 1fr); }
    .post-aside { position: static; order: 2; }
    .toc { display: none; }
    .related-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
