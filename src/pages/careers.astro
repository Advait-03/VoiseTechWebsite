---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Form from '../components/Form.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';

const values = [
  { title: 'Innovation', text: 'Always evolving to stay ahead of the curve', image: '/wp-content/uploads/2025/09/innovation.jpg', icon: '/wp-content/uploads/2025/09/innovation.svg' },
  { title: 'Transparency', text: 'Clear, open communication with partners and teammates', image: '/wp-content/uploads/2025/09/Transparency.jpg', icon: '/wp-content/uploads/2025/09/Transparency.svg' },
  { title: 'Excellence', text: 'Focused on measurable outcomes, not empty promises', image: '/wp-content/uploads/2025/09/Excellence.jpg', icon: '/wp-content/uploads/2025/09/Excellence.svg' },
  { title: 'Collaboration', text: 'A team-first mindset where every idea counts', image: '/wp-content/uploads/2025/09/Collaboration.jpg', icon: '/wp-content/uploads/2025/09/Collaboration.svg' },
];
const unique = [
  'A proprietary tech stack and global demand access',
  'Expertise across all ad formats: display, video, CTV, audio',
  'Relentless focus on fraud prevention and brand safety',
  'A proven ability to deliver clarity in a complex ecosystem',
];
const why = [
  'Work with a global team of AdTech experts',
  'Innovate and shape the future of digital advertising',
  'Enjoy a flexible work culture that values results, not hours',
  'Gain hands-on exposure to advanced AdTech tools and strategies',
  'Build a career with a company that scales as fast as the industry does',
];
---
<BaseLayout
  title="Careers - Voise Tech"
  description="Careers at Voise Tech. Shape the Future of Programmatic. Grow with Us. Our global team builds technology that makes advertising smarter, safer, and more transparent."
  breadcrumbs={[{ label: 'Careers', href: '/careers/' }]}
>
  <PageHero
    eyebrow="Careers at Voise Tech"
    title="Shape the Future of Programmatic. <span class='grad-text'>Grow with Us.</span>"
    lede="At Voise Tech, we don’t just follow the AdTech industry — we redefine it. Our global team builds technology that makes advertising smarter, safer, and more transparent. If you’re looking for a place where innovation meets impact, you’ve found it."
    crumbs={[{ label: 'Careers', href: '/careers/' }]}
  >
    <div class="cluster" slot="actions">
      <a class="btn" href="#apply">Apply Now <Icon name="arrow" size={16} class="arrow" /></a>
      <a class="btn btn-secondary" href="/about-us/#team">Meet the team</a>
    </div>
  </PageHero>

  <section class="section-sm">
    <div class="container who">
      <div class="media who-media" data-reveal="mask">
        <Img src="/wp-content/uploads/2025/08/Who-We-Are-career.png" alt="A Voise Tech team member working at a laptop" sizes="(max-width: 860px) 100vw, 45vw" />
      </div>
      <div class="who-copy">
        <SectionHeading eyebrow="Who we are" title="Global Vision. Local Impact. Real Results." />
        <p class="lede" data-reveal>Voise Tech is a global AdTech company specializing in publisher monetization and programmatic media buying.</p>
        <p class="muted" data-reveal>Our proprietary tech stack connects premium publishers with top-tier demand partners worldwide, powering scalable, data-driven solutions across display, video, CTV, audio.</p>
      </div>
    </div>
  </section>

  <section class="section tone-subtle">
    <div class="container">
      <SectionHeading eyebrow="Values" title="What we value." />
      <ul role="list" class="values" data-stagger>
        {values.map((v) => (
          <li data-reveal class="value">
            <div class="media value-media"><Img src={v.image} alt="" sizes="(max-width: 900px) 50vw, 25vw" /></div>
            <span class="value-icon"><img src={v.icon} alt="" width="26" height="26" loading="lazy" decoding="async" /></span>
            <h3 class="h4">{v.title}</h3>
            <p class="muted small">{v.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container two">
      <div>
        <SectionHeading eyebrow="What makes us unique?" title="AdTech with an Edge." lede="We’re not just another platform. We stand apart with:" />
        <ul role="list" class="checks" data-stagger>
          {unique.map((u) => <li data-reveal><span class="tick"><Icon name="check" size={14} stroke={2.2} /></span>{u}</li>)}
        </ul>
      </div>
      <div>
        <SectionHeading eyebrow="Why work with us?" title="Your Growth = Our Growth." lede="Joining Voise Tech means more than just a job. It’s a chance to:" />
        <ol role="list" class="why" data-stagger>
          {why.map((w, i) => <li data-reveal><span class="mono">0{i + 1}</span>{w}</li>)}
        </ol>
      </div>
    </div>
  </section>

  <section class="section on-night apply" id="apply">
    <div class="container apply-grid">
      <div class="apply-copy">
        <SectionHeading eyebrow="Join us" title="Be Part of Something Bigger." lede="If you’re passionate about building the future of programmatic advertising, Voise Tech is the place to do it. Bring your ideas, your curiosity, and your drive—we’ll give you the platform to thrive." />
        <p class="note" data-reveal>Submit a general application with your cover letter and resume. Tell us the role you’re interested in and our team will be in touch if there’s a fit.</p>
      </div>
      <div class="form-card" data-reveal style="--i:1">
        <h2 class="h3">Apply now</h2>
        <Form id="careers" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .who { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 80px); align-items: center; }
  .who-media { aspect-ratio: 565 / 419; }
  .who-copy { display: grid; gap: 22px; }
  @media (max-width: 860px) { .who { grid-template-columns: minmax(0, 1fr); } }
  .values { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; margin-top: clamp(32px, 4vw, 56px); }
  .value { position: relative; display: grid; gap: 10px; align-content: start; }
  .value-media { aspect-ratio: 1000 / 602; margin-bottom: 10px; }
  .value-icon { position: absolute; top: 12px; left: 12px; width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; background: linear-gradient(135deg, var(--blue), #0b5aa0 55%, #0a7f43); box-shadow: 0 6px 16px rgb(8 112 199 / 0.3); }
  @media (max-width: 900px) { .values { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .values { grid-template-columns: minmax(0, 1fr); } }
  .two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(40px, 6vw, 96px); }
  .two > div { display: grid; gap: 28px; align-content: start; }
  .checks, .why { border-top: 1px solid var(--line); }
  .checks li, .why li { display: flex; gap: 14px; align-items: center; padding: 18px 0; border-bottom: 1px solid var(--line); font-weight: 500; }
  .why .mono { color: var(--blue-ink); width: 28px; flex: none; }
  .tick { width: 26px; height: 26px; border-radius: 50%; background: var(--blue-soft); color: var(--blue-ink); display: grid; place-items: center; flex: none; }
  @media (max-width: 860px) { .two { grid-template-columns: minmax(0, 1fr); } }
  .apply { background: radial-gradient(70% 60% at 100% 0%, rgb(8 112 199 / 0.3), transparent 60%), var(--night); }
  .apply-grid { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(32px, 5vw, 80px); align-items: start; }
  .apply-copy { display: grid; gap: 24px; position: sticky; top: 100px; }
  .note { color: var(--ink-inverse-2); font-size: var(--fs-small); max-width: 46ch; }
  .form-card { padding: clamp(24px, 3.5vw, 44px); border-radius: var(--radius-l); background: #fff; color: var(--ink); display: grid; gap: 14px; }
  .form-card :global(.muted), .form-card :global(.lede) { color: var(--ink-2); }
  @media (max-width: 960px) { .apply-grid { grid-template-columns: minmax(0, 1fr); } .apply-copy { position: static; } }
</style>
