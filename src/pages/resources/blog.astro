---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ResourceTabs from '../../components/ResourceTabs.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import Img from '../../components/Img.astro';
import Icon from '../../components/Icon.astro';
import { allPosts, allTags, postItem, formatDate, readingTime } from '../../lib/content';

const posts = await allPosts();
const [featured] = posts;
const tags = (await allTags()).filter((t) => t.count >= 2).slice(0, 12);
const allTagList = await allTags();
---
<BaseLayout
  title="Voise Tech Blog | Latest Updates & Insights"
  description="Read the latest blogs from Voise Tech for expert insights on digital advertising, programmatic solutions, Google Ad Manager, and the latest trends shaping the ad tech industry."
  breadcrumbs={[{ label: 'Resources', href: '/resources/blog/' }, { label: 'Voise Blogs', href: '/resources/blog/' }]}
>
  <PageHero eyebrow="Resources" title="Voise Blogs" lede="Perspectives on programmatic advertising, CTV, curation and agentic AI." crumbs={[{ label: 'Resources', href: '/resources/blog/' }, { label: 'Voise Blogs', href: '/resources/blog/' }]} />
  <ResourceTabs />

  <section class="container" data-featured-block>
    <a class="featured is-link" href={`/${featured.id}/`} data-reveal>
      <div class="media f-media">
        {(featured.data.banner ?? featured.data.image) && <Img src={(featured.data.image ?? featured.data.banner)!.src} alt="" sizes="(max-width: 900px) 100vw, 55vw" loading="eager" />}
      </div>
      <div class="f-copy">
        <p class="mono f-meta"><span class="latest">Latest</span> <time datetime={featured.data.date.toISOString()}>{formatDate(featured.data.date)}</time> · {readingTime(featured.body)} min read</p>
        <h2 class="h2 f-title">{featured.data.title}</h2>
        <p class="muted">{featured.data.excerpt}</p>
        <span class="link-arrow"><span class="label">Read article</span><Icon name="arrow" size={14} class="arrow" /></span>
      </div>
    </a>
  </section>

  <section class="section-sm container" data-blog>
    <div class="controls" hidden data-filters>
      <div class="filters" role="group" aria-label="Filter articles by topic">
        <button type="button" class="chip" aria-pressed="true" data-filter="">All topics</button>
        {tags.map((t) => <button type="button" class="chip" aria-pressed="false" data-filter={t.slug}>{t.name}</button>)}
      </div>
      <label class="search">
        <span class="sr-only">Search articles</span>
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
        <input type="search" placeholder="Search articles: CTV, curation, SSP…" autocomplete="off" data-search />
      </label>
    </div>
    <p class="sr-only" role="status" data-filter-status></p>
    <ul role="list" class="grid" data-grid>
      {posts.map((p, i) => (
        <li data-tags={p.data.tags.map((t) => t.slug).join(' ')} data-text={`${p.data.title} ${p.data.excerpt ?? ''}`.toLowerCase()} data-featured={i === 0 ? '' : undefined} data-card>
          <ResourceCard item={postItem(p)} headingLevel="h2" />
        </li>
      ))}
    </ul>
    <p class="empty muted" hidden data-empty>No articles match. Try another word or topic.</p>
    <div class="more"><button type="button" class="btn btn-secondary" hidden data-more>Load more articles</button></div>

    <nav class="topics" aria-label="Browse all topics">
      <h2 class="mono topics-title">Browse by topic</h2>
      <ul role="list">
        {allTagList.map((t) => <li><a class="pill" href={`/tag/${t.slug}/`}>{t.name} <span class="count">{t.count}</span></a></li>)}
      </ul>
    </nav>
  </section>
</BaseLayout>

<style>
  .featured { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: clamp(28px, 4vw, 64px); align-items: center; }
  .f-media { aspect-ratio: 551 / 355; }
  .f-copy { display: grid; gap: 18px; justify-items: start; }
  .f-meta { color: var(--ink-2); display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .latest { color: #fff; background: var(--ink); padding: 3px 9px; border-radius: 999px; }
  .f-title { font-size: clamp(1.7rem, 1.2rem + 1.8vw, 2.75rem); transition: color var(--dur); }
  .featured:hover .f-title { color: var(--blue-ink); }
  @media (max-width: 900px) { .featured { grid-template-columns: minmax(0, 1fr); } }

  .controls { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 24px; margin-bottom: 40px; }
  .controls[hidden] { display: none; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; }
  .search { display: flex; align-items: center; gap: 10px; height: 44px; padding: 0 16px; border: 1px solid var(--line-strong); border-radius: 999px; width: min(100%, 340px); color: var(--ink-3); transition: border-color var(--dur); }
  .search:focus-within { border-color: var(--ink); color: var(--ink); }
  .search input { flex: 1; min-width: 0; border: 0; background: none; font: inherit; font-size: var(--fs-small); color: var(--ink); outline: none; }
  .chip { height: 36px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--line-strong); font-size: var(--fs-xs); font-weight: 500; color: var(--ink-2); transition: background-color var(--dur), color var(--dur), border-color var(--dur); }
  .chip:hover { border-color: var(--ink); color: var(--ink); }
  .chip[aria-pressed='true'] { background: var(--ink); color: #fff; border-color: var(--ink); }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(36px, 4vw, 56px) clamp(20px, 2.5vw, 32px); }
  .grid li[hidden] { display: none; }
  @media (prefers-reduced-motion: no-preference) { .grid li.is-new { animation: rise 600ms var(--ease-out) both; } }
  @keyframes rise { from { opacity: 0; transform: translateY(16px); } }
  @media (max-width: 960px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .grid { grid-template-columns: minmax(0, 1fr); } }
  .empty { margin-top: 24px; }
  .more { display: flex; justify-content: center; margin-top: 56px; }
  .topics { margin-top: clamp(64px, 8vw, 104px); padding-top: 32px; border-top: 1px solid var(--line); }
  .topics-title { color: var(--ink-3); margin-bottom: 16px; }
  .topics ul { display: flex; flex-wrap: wrap; gap: 8px; }
  .topics a:hover { border-color: var(--ink); color: var(--ink); }
  .count { color: var(--ink-3); font-family: var(--font-mono); font-size: 0.7rem; }
</style>

<script>
  const PAGE = 12;
  const root = document.querySelector<HTMLElement>('[data-blog]');
  if (root) {
    const cards = [...root.querySelectorAll<HTMLElement>('[data-card]')];
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const more = root.querySelector<HTMLButtonElement>('[data-more]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const status = root.querySelector<HTMLElement>('[data-filter-status]')!;
    const search = root.querySelector<HTMLInputElement>('[data-search]')!;
    const featuredBlock = document.querySelector<HTMLElement>('[data-featured-block]');
    root.querySelector<HTMLElement>('[data-filters]')!.hidden = false;
    let filter = '';
    let terms: string[] = [];
    let shown = PAGE;

    function render(animateFrom = -1) {
      // The latest post sits in the featured block; it joins the grid only while filtering or searching.
      const active = !!filter || terms.length > 0;
      if (featuredBlock) featuredBlock.hidden = active;
      const matching = cards.filter((c) =>
        (active || !c.hasAttribute('data-featured')) &&
        (!filter || (c.dataset.tags ?? '').split(' ').includes(filter)) &&
        terms.every((t) => (c.dataset.text ?? '').includes(t)));
      cards.forEach((c) => (c.hidden = true));
      matching.forEach((c, i) => {
        c.hidden = i >= shown;
        c.classList.toggle('is-new', animateFrom >= 0 && i >= animateFrom && i < shown);
      });
      more.hidden = matching.length <= shown;
      empty.hidden = matching.length > 0;
      status.textContent = `${Math.min(shown, matching.length)} of ${matching.length} articles shown`;
    }
    search.addEventListener('input', () => {
      terms = search.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      shown = PAGE;
      render(0);
    });
    chips.forEach((chip) => chip.addEventListener('click', () => {
      filter = chip.dataset.filter ?? '';
      shown = PAGE;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      render(0);
    }));
    more.addEventListener('click', () => {
      const from = shown;
      shown += PAGE;
      render(from);
      const next = cards.filter((c) => !c.hidden)[from];
      next?.querySelector<HTMLAnchorElement>('a')?.focus({ preventScroll: true });
    });
    render();
  }
</script>
