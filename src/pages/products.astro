---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StackMap from '../components/StackMap.astro';
import CtaBand from '../components/CtaBand.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import products from '../data/products.json';
import { platformProduct, publisherProducts, buyerProducts } from '../data/navigation';

const platform = products.find((p) => p.category === 'platform')!;

const groups = [
  {
    id: 'publishers', eyebrow: 'Publishers', title: 'Full Control. Real Demand. Better Yield.', href: '/ad-publishers-solutions/', image: '/brand/art/publishers.svg', alt: 'Illustration: publisher inventory going through a real-time auction to a served ad',
    text: 'Publisher products work around Voise AdServer: Pre-Bid brings header-bidding demand into the auction, Voise SSP takes inventory to programmatic demand, and Content Production makes the creative that runs on it.',
    links: publisherProducts,
  },
  {
    id: 'buyers', eyebrow: 'Buyers', title: 'Clarity, Efficiency, and Performance at Scale', href: '/ad-buyers-solutions/', image: '/brand/art/buyers.svg', alt: 'Illustration: a campaign planner with audiences, channels, reach and brand safety',
    text: 'Buyer products help agencies and brands plan, target, create and activate. Curated deals reach supply through deal IDs that the AdServer carries end to end, and planning and audience tools draw on the same platform as it grows.',
    links: buyerProducts,
  },
];
---
<BaseLayout
  title="Products - Voise Tech"
  description="One platform, built around Voise AdServer: OpenRTB, video and CTV, DOOH and reporting, with publisher and buyer products connected to it."
  breadcrumbs={[{ label: 'Products', href: '/products/' }]}
>
  <PageHero
    eyebrow="Products"
    title="One Platform. <span class='grad-text'>Every Side of the Market.</span>"
    lede={[
      'Everything VoiseTech builds starts with Voise AdServer, one omnichannel ad server for OpenRTB, video and CTV, DOOH and reporting.',
      'Publisher products bring demand and creative into it. Buyer products plan, target and activate against it. Because they share one platform, data and decisions carry through from the first bid request to the last report.',
    ]}
    crumbs={[{ label: 'Products', href: '/products/' }]}
    split
  >
    <div class="cluster" slot="actions">
      <a class="btn" href={platformProduct.href}>Explore Voise AdServer <Icon name="arrow" size={16} class="arrow" /></a>
      <a class="btn btn-secondary" href="/contact-us/">Enquire Now</a>
    </div>
    <div slot="visual" class="visual">
      <StackMap />
      <p class="mono cap">Select a product to explore it</p>
    </div>
  </PageHero>

  <section class="section on-night platform" id="platform">
    <div class="container">
      <div class="platform-head">
        <SectionHeading eyebrow="Core platform" title={platform.name} lede={platform.intro[0]} />
        <a class="btn" href={platformProduct.href} data-reveal>Explore the platform <Icon name="arrow" size={16} class="arrow" /></a>
      </div>
      <ol role="list" class="surfaces" data-stagger>
        {platform.edge.map((e: { title: string; text?: string; status?: string }, i) => (
          <li data-reveal>
            <span class="mono s-n">0{i + 1}</span>
            <h3 class="h4">{e.title}</h3>
            <p>{e.text}</p>
            {e.status && <span class="status mono">{e.status}</span>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  {groups.map((g, gi) => (
    <section class:list={['section', gi % 2 === 1 && 'tone-subtle']} id={g.id}>
      <div class="container group">
        <div class="media group-media" data-reveal="mask">
          <Img src={g.image} alt={g.alt} sizes="(max-width: 900px) 100vw, 45vw" />
        </div>
        <div class="group-copy">
          <SectionHeading eyebrow={g.eyebrow} title={g.title} />
          <p class="muted" data-reveal>{g.text}</p>
          <ul role="list" class="group-links" data-stagger>
            {g.links.map((l, i) => (
              <li data-reveal>
                <a href={l.href}>
                  <span class="mono">0{i + 1}</span>
                  <span class="gl-name">{l.label}</span>
                  <span class="gl-desc">{l.description}</span>
                  <Icon name="arrow" size={16} class="arrow" />
                </a>
              </li>
            ))}
          </ul>
          <a class="btn btn-secondary" href={g.href} data-reveal>Read More <Icon name="arrow" size={16} class="arrow" /></a>
        </div>
      </div>
    </section>
  ))}

  <section class="section on-night partners-sec">
    <div class="container partners">
      <SectionHeading eyebrow="Partners" title="Technology, Data, and Growth" lede="Voise Tech collaborates with agencies, data providers, and tech platforms to co-create better solutions across the programmatic supply chain. Our partner ecosystem is designed to scale innovation, accelerate integrations, and deliver mutual value." />
      <a class="btn" href="/google-ad-manager-solutions-services/" data-reveal>Partner with Us <Icon name="arrow" size={16} class="arrow" /></a>
    </div>
  </section>

  <CtaBand eyebrow="Start the conversation" title="Let’s Build What’s Next in Programmatic Advertising - Together." primary={{ label: 'Enquire Now', href: '/contact-us/' }} secondary={{ label: 'Compare solutions', href: '/solutions/' }} />
</BaseLayout>

<style>
  .visual { display: grid; gap: 12px; }
  .platform-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 28px; }
  .platform-head :global(.lede) { max-width: 62ch; }
  .surfaces { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; margin-top: clamp(36px, 5vw, 64px); background: var(--line-night); border: 1px solid var(--line-night); border-radius: var(--radius-l); overflow: hidden; }
  .surfaces li { background: var(--night); padding: clamp(22px, 2.4vw, 32px); display: grid; gap: 12px; align-content: start; }
  .surfaces p { color: var(--ink-inverse-2); font-size: var(--fs-small); }
  .s-n { color: var(--sky); }
  .surfaces .status { justify-self: start; padding: 4px 10px; border-radius: 999px; border: 1px solid rgb(255 255 255 / 0.22); color: var(--ink-inverse-2); font-size: 0.66rem; letter-spacing: 0.06em; text-transform: uppercase; }
  @media (max-width: 1000px) { .surfaces { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .surfaces { grid-template-columns: minmax(0, 1fr); } }
  .cap { color: var(--ink-3); text-align: center; font-size: 0.68rem; }
  .group { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(32px, 5vw, 80px); align-items: center; }
  .group-media { aspect-ratio: 564 / 420; }
  .group-copy { display: grid; gap: 22px; justify-items: start; }
  .tone-subtle .group-media { order: 2; }
  .group-links { width: 100%; border-top: 1px solid var(--line); }
  .group-links a { display: grid; grid-template-columns: 32px minmax(160px, 0.9fr) 1fr 20px; gap: 12px; align-items: center; padding: 16px 4px; border-bottom: 1px solid var(--line); transition: background-color var(--dur), padding var(--dur) var(--ease-out); }
  .group-links a:hover { background: rgb(8 112 199 / 0.04); padding-left: 10px; }
  .group-links .mono { color: var(--ink-3); }
  .gl-name { font-weight: 600; letter-spacing: -0.015em; }
  .gl-desc { font-size: var(--fs-xs); color: var(--ink-2); }
  .group-links :global(.arrow) { color: var(--ink-3); }
  @media (max-width: 900px) { .group { grid-template-columns: minmax(0, 1fr); } .tone-subtle .group-media { order: 0; } }
  @media (max-width: 560px) { .group-links a { grid-template-columns: 32px 1fr 20px; } .gl-desc { grid-column: 2; } }
  .partners { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 32px; }
</style>
