---
/** VoiseTech.AI landing page - copy migrated from the live /voisetechai/ page. */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StatGrid from '../components/StatGrid.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { aiStats } from '../data/stats';

const AI = 'https://voisetech.ai';
const ticker = [
  'Free tier - start instantly, no credit card needed', 'Conversational AI across all domains', 'Generate complete applications - not just snippets',
  'Live preview & architecture view', 'Learns your preferences over time', 'Multiple AI models - Claude, GPT & Gemini in one place',
  'Powered by Claude Opus & Sonnet - frontier intelligence', 'Credit-based - pay per use, scale as you go',
];
const modes = [
  {
    tag: 'Most Popular', name: 'Ask Me Anything', subtitle: 'The AI that listens and learns.', cta: 'Start Asking',
    text: 'Your AI that learns and gets smarter with every conversation. Multi-AI powered - Claude, GPT & Gemini. Get expert-level answers across engineering, architecture, strategy, and beyond.',
    lede: 'Not a search engine. Not a chatbot. A reasoning partner that gets sharper every time you use it.',
    points: [
      ['Conversational AI across all domains', 'Engineering, strategy, marketing, legal - switch topics mid-conversation without losing context.'],
      ['Learns your preferences over time', 'The more you use it, the better it knows your style, stack, and standards. It adapts, you accelerate.'],
      ['Multiple AI models in one place', 'Claude, GPT & Gemini - routed intelligently by task type. Best model for the job, every time.'],
      ['Free tier - start instantly', 'No credit card. No commitment. Jump in now and experience frontier AI without a barrier in sight.'],
    ],
  },
  {
    tag: 'For Developers', name: 'Build Anything', subtitle: 'The IDE that builds with you.', cta: 'Start Building',
    text: 'AI-powered workspace for production-ready code. Full-stack generation with live preview - from a single function to an entire deployable application.',
    lede: 'From a single prompt to a production-ready codebase - with live preview and architectural clarity baked in.',
    points: [
      ['Generate complete applications', 'Not snippets. Full projects - auth, APIs, DB schemas, CI configs - ready to clone and ship.'],
      ['Live preview & architecture view', 'See your app render in real time. Visualise system architecture as it’s being generated - no guesswork.'],
      ['Powered by Claude Opus & Sonnet', 'Frontier models purpose-built for complex code generation. The most capable AI, applied to your build.'],
      ['Credit-based - pay per use', 'No subscriptions, no wasted seat licences. Pay only for what you build. Scale down or go all-in anytime.'],
    ],
  },
];
const capabilities = [
  ['Full-stack development', 'React, Next.js, Node, Python, Go - production-ready apps from frontend to database, deployed and live. VoiseTech writes clean, scalable code that ships.', 'Frontend · Backend · Database'],
  ['AI & machine learning', 'Custom models, NLP pipelines, computer vision - built and integrated end-to-end.', 'Models · Pipelines · APIs'],
  ['System architecture', 'Microservices, event-driven systems, distributed infrastructure - designed for scale and reliability from day one.', ''],
  ['Intelligent Q&A', 'Ask anything technical - get expert-level answers instantly, not generic documentation links.', ''],
  ['Mobile apps - iOS & Android', 'React Native, Flutter, Swift, Kotlin - cross-platform or fully native. Built with full API integration, auth flows, and App Store-ready build configs.', 'Cross-platform · Native · PWA'],
  ['DevOps & cloud', 'Docker, Kubernetes, CI/CD, AWS, GCP, Azure - deployments automated and infrastructure production-ready.', ''],
  ['API development', 'REST, GraphQL, WebSocket, gRPC - APIs that are fast, documented, and production-grade.', 'REST · GraphQL · Realtime'],
];
const builds = [
  ['01 / SaaS', 'SaaS platforms', 'Auth, billing, dashboards, analytics, onboarding - full SaaS stack, ready to launch.', 'Launch-ready'],
  ['02 / Commerce', 'E-commerce stores', 'Product catalogs, checkout, inventory, order management - conversion-optimised by design.', 'High-converting'],
  ['03 / Intelligence', 'AI-powered apps', 'Recommendation engines, prediction systems, intelligent assistants, RAG pipelines.', 'AI-native'],
  ['04 / Insights', 'Enterprise dashboards', 'Real-time analytics, KPI monitoring, live data pipelines, visual business intelligence.', 'Real-time data'],
  ['05 / Systems', 'Custom business tools', 'Workflow automation, internal ops platforms, integrations - tailored to your processes.', 'Process automation'],
  ['06 / Infrastructure', 'Scalable backends', 'High-traffic microservices, real-time systems, event-driven architecture for enterprise load.', 'Enterprise-grade'],
];
const stacks = [
  ['Frontend', 'React · Vue · Next.js · Angular · TypeScript · Tailwind'],
  ['Backend', 'Node.js · Python · Go · Rust · Java · C# · PHP'],
  ['Databases', 'PostgreSQL · MongoDB · Redis · Elasticsearch · Supabase'],
  ['Cloud', 'AWS · GCP · Azure · Vercel · Railway · Cloudflare'],
  ['DevOps', 'Docker · Kubernetes · GitHub Actions · Terraform · Jenkins'],
  ['LLM Integrations', 'OpenAI · Anthropic · Gemini · Meta AI · DeepSeek · Bedrock'],
];
const outcomes = [
  ['Startup MVP', 'Go from napkin idea to live product. Auth, core features, database, deployment - complete and shipped before a sprint ends.', 'concept to live: under 24 hours'],
  ['Enterprise integration', 'Modernize legacy systems, build integration layers, automate workflows - without the 6-month consulting engagement.', 'legacy modernization at scale'],
  ['Data intelligence', 'Raw data into real-time dashboards, ML models, automated reporting pipelines - business decisions backed by live data.', 'real-time business intelligence'],
  ['Process automation', 'Eliminate manual workflows, build intelligent automation that learns and scales - 90%+ efficiency gains, measurably.', '90%+ operational efficiency'],
];
---
<BaseLayout
  title="VoiseTech.AI - Voise Tech"
  description="VoiseTech AI combines the reasoning power of a senior engineer, the creativity of a product builder, and the precision of an enterprise architect - in one conversation. Now live at voisetech.ai."
  breadcrumbs={[{ label: 'VoiseTech.AI', href: '/voisetechai/' }]}
>
  <section class="ai-hero on-night">
    <div class="container ai-hero-grid">
      <div class="copy">
        <p class="pill live" data-reveal><span class="dot"></span>Now live at voisetech.ai</p>
        <h1 class="display" data-reveal style="--i:1">The AI that can <span class="rotator" data-rotator aria-live="off"><span>write your code</span><span>build your app</span><span>answer anything</span><span>scale your business</span><span>design your system</span></span></h1>
        <p class="lede" data-reveal style="--i:2">VoiseTech AI combines the reasoning power of a senior engineer, the creativity of a product builder, and the precision of an enterprise architect - in one conversation.</p>
        <form class="ask" action={AI} method="get" target="_blank" data-reveal style="--i:3">
          <label for="ai-ask" class="sr-only">Ask VoiseTech AI anything</label>
          <input id="ai-ask" type="text" placeholder="Ask me anything - code, architecture, strategy…" autocomplete="off" />
          <button class="btn" type="submit">Open voisetech.ai <Icon name="arrow-up-right" size={16} class="arrow" /></button>
        </form>
        <ul role="list" class="chips" data-reveal style="--i:4">
          {['Build a SaaS page', 'Explain transformers', 'FastAPI backend', 'Microservices design', 'React dashboard'].map((c) => <li class="pill">{c}</li>)}
        </ul>
      </div>
      <div class="chat" aria-hidden="true" data-reveal="fade" style="--i:2">
        <div class="chat-head"><span class="dot"></span>VoiseTech AI <span class="mono">Online</span></div>
        <div class="msg u"><b>U</b><p>Build me a user auth system with JWT and refresh tokens in Node.js</p></div>
        <div class="msg v"><b>V</b><p><code>Express</code> <code>jsonwebtoken</code><br /><code>authController.js</code> <code>middleware/auth.js</code></p></div>
        <div class="msg u"><b>U</b><p>Also add role-based access control</p></div>
        <div class="msg v"><b>V</b><p><code>RBAC middleware</code> <code>@requireRole('admin')</code></p></div>
      </div>
    </div>
    <div class="container"><StatGrid stats={aiStats} variant="night" /></div>
    <div class="ticker" aria-hidden="true" data-play-in-view>
      <div class="ticker-track">{[...ticker, ...ticker].map((t) => <span>{t}<i>·</i></span>)}</div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="Two products. One platform." title="Everything you need to think faster and ship smarter" lede="Whether you’re looking for answers or looking to build - VoiseTech AI has a dedicated mode for each." />
      <div class="modes" data-stagger>
        {modes.map((m) => (
          <article class="mode card" data-reveal>
            <p class="mono tag">{m.tag}</p>
            <h3 class="h2">{m.name}</h3>
            <p class="muted">{m.text}</p>
            <h4 class="h4 sub">{m.subtitle}</h4>
            <p class="small muted">{m.lede}</p>
            <dl class="points">{m.points.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
            <a class="btn" href={AI} target="_blank" rel="noopener noreferrer">{m.cta}<Icon name="arrow-up-right" size={16} class="arrow" /><span class="sr-only"> (opens voisetech.ai in a new tab)</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section tone-subtle">
    <div class="container">
      <SectionHeading eyebrow="Core capabilities" title="One platform. Every problem solved." lede="From a quick question to a full production system - VoiseTech handles depth at every level." />
      <ul role="list" class="caps" data-stagger>
        {capabilities.map(([t, d, k]) => <li class="card" data-reveal><h3 class="h4">{t}</h3><p class="muted small">{d}</p>{k && <p class="mono k">→ {k}</p>}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container two">
      <div>
        <SectionHeading eyebrow="Accessible at voisetech.ai" title="Ask. Build. Deploy." lede="Just describe what you want. VoiseTech reasons through your problem, produces working code, explains the architecture, and helps you ship - without switching tabs." />
        <a class="btn" href={AI} target="_blank" rel="noopener noreferrer" data-reveal>Start building at voisetech.ai <Icon name="arrow-up-right" size={16} class="arrow" /></a>
      </div>
      <dl class="list-dl" data-stagger>
        {[['Conversational coding', 'Go from idea to working code in natural language'], ['Multi-file project generation', 'Full repos, not just snippets - ready to clone and run'], ['Architecture guidance', 'System design, trade-off analysis, and tech decisions'], ['50+ technology stacks', 'Whatever you’re building in, VoiseTech knows it deeply']].map(([k, v]) => <div data-reveal><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="section on-night">
    <div class="container">
      <SectionHeading eyebrow="What we build" title="Ideas become products. Fast." lede="VoiseTech doesn’t just answer - it builds. Here’s what teams ship with it." />
      <ul role="list" class="builds" data-stagger>
        {builds.map(([n, t, d, k]) => <li data-reveal><p class="mono n">{n}</p><h3 class="h4">{t}</h3><p class="small">{d}</p><p class="mono k">→ {k}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container two">
      <SectionHeading eyebrow="Technology" title="Mastery across every stack" lede="50+ technologies. Zero compromise on depth. VoiseTech knows each stack the way an expert does - not just the syntax, but the trade-offs." />
      <dl class="stacks" data-stagger>{stacks.map(([k, v]) => <div data-reveal><dt class="mono">{k}</dt><dd>{v}</dd></div>)}</dl>
    </div>
  </section>

  <section class="section tone-subtle">
    <div class="container">
      <SectionHeading eyebrow="Real outcomes" title="VoiseTech.AI does in minutes what teams build in hours" lede="Empowering you to move at the speed of thought, not the speed of workflows." />
      <ul role="list" class="outcomes" data-stagger>
        {outcomes.map(([t, d, k]) => <li class="card" data-reveal><h3 class="h4">{t}</h3><p class="muted small">{d}</p><p class="mono k">→ {k}</p></li>)}
      </ul>
    </div>
  </section>

  <CtaBand eyebrow="Get started today" title="Build the future. Starting now." text="Join thousands of developers, startups, and enterprises who trust VoiseTech AI to turn ideas into reality - faster than ever before." primary={{ label: 'Explore VoiseTech.AI', href: AI }} />
</BaseLayout>

<style>
  .ai-hero { position: relative; overflow: hidden; padding-block: clamp(56px, 8vw, 112px) 0; background: radial-gradient(60% 70% at 85% 10%, rgb(16 120 187 / 0.35), transparent 65%), radial-gradient(50% 60% at 0% 90%, rgb(31 173 83 / 0.18), transparent 65%), var(--night); }
  .ai-hero-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr); gap: clamp(32px, 5vw, 72px); align-items: center; margin-bottom: clamp(56px, 7vw, 96px); }
  .copy { display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; justify-items: start; }
  .copy > * { min-width: 0; max-width: 100%; }
  .live .dot { background: var(--green-bright); box-shadow: 0 0 0 4px rgb(47 214 122 / 0.2); }
  .display { font-size: clamp(2.6rem, 1.4rem + 4.6vw, 5.5rem); }
  .rotator { display: inline-grid; vertical-align: bottom; max-width: 100%; }
  .rotator span { grid-area: 1 / 1; background: linear-gradient(90deg, var(--sky), var(--green-bright)); -webkit-background-clip: text; background-clip: text; color: transparent; opacity: 0; transform: translateY(0.4em); transition: opacity 500ms var(--ease-out), transform 500ms var(--ease-out); padding-bottom: 0.06em; }
  .rotator span.is-on, .rotator:not(.is-ready) span:first-child { opacity: 1; transform: none; }
  .ask { display: flex; gap: 8px; width: 100%; max-width: 620px; padding: 8px; border-radius: 999px; background: rgb(255 255 255 / 0.06); border: 1px solid var(--line-night-strong); }
  .ask input { flex: 1; min-width: 0; background: none; border: 0; padding: 0 14px; color: #fff; font-size: 1rem; }
  .ask input::placeholder { color: var(--ink-inverse-2); }
  .ask input:focus { outline: none; }
  .ask:focus-within { border-color: var(--sky); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chat { border: 1px solid var(--line-night-strong); border-radius: var(--radius-l); background: rgb(255 255 255 / 0.04); padding: 18px; display: grid; gap: 12px; font-size: var(--fs-small); }
  .chat-head { display: flex; align-items: center; gap: 8px; font-weight: 600; padding-bottom: 10px; border-bottom: 1px solid var(--line-night); }
  .chat-head .dot { background: var(--green-bright); }
  .chat-head .mono { margin-left: auto; color: var(--green-bright); }
  .msg { display: grid; grid-template-columns: 28px 1fr; gap: 10px; align-items: start; }
  .msg b { width: 28px; height: 28px; border-radius: 8px; display: grid; place-items: center; font-size: 0.75rem; background: rgb(255 255 255 / 0.1); }
  .msg.v b { background: var(--grad); }
  .msg p { padding: 10px 12px; border-radius: 12px; background: rgb(255 255 255 / 0.06); color: var(--ink-inverse); }
  .msg code { font-family: var(--font-mono); font-size: 0.78rem; color: var(--sky); }
  @media (max-width: 960px) { .ai-hero-grid { grid-template-columns: minmax(0, 1fr); } }
  .ticker { margin-top: clamp(48px, 6vw, 80px); border-top: 1px solid var(--line-night); padding-block: 18px; overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .ticker-track { display: flex; width: max-content; animation: tick 60s linear infinite; font-family: var(--font-mono); font-size: 0.78rem; color: var(--ink-inverse-2); letter-spacing: 0.04em; }
  .ticker[data-paused] .ticker-track { animation-play-state: paused; }
  .ticker-track span { white-space: nowrap; }
  .ticker-track i { font-style: normal; margin: 0 22px; color: var(--sky); }
  @keyframes tick { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .ticker-track { animation: none; flex-wrap: wrap; width: auto; } }
  .modes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin-top: clamp(32px, 4vw, 56px); }
  .mode { padding: clamp(28px, 3.5vw, 48px); display: grid; gap: 14px; align-content: start; justify-items: start; }
  .tag { color: var(--blue-ink); }
  .sub { margin-top: 10px; }
  .points { display: grid; gap: 14px; margin: 8px 0 12px; padding-top: 18px; border-top: 1px solid var(--line); width: 100%; }
  .points dt { font-weight: 600; font-size: var(--fs-small); }
  .points dd { margin: 2px 0 0; color: var(--ink-2); font-size: var(--fs-small); }
  @media (max-width: 860px) { .modes { grid-template-columns: minmax(0, 1fr); } }
  .caps { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; margin-top: clamp(32px, 4vw, 56px); }
  .caps li, .outcomes li { padding: 26px; display: grid; gap: 10px; align-content: start; }
  .k { color: var(--blue-ink); margin-top: 6px; }
  .two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .two > div { display: grid; gap: 28px; justify-items: start; }
  .list-dl, .stacks { border-top: 1px solid var(--line); }
  .list-dl div, .stacks div { padding: 18px 0; border-bottom: 1px solid var(--line); display: grid; gap: 4px; }
  .list-dl dt { font-weight: 600; }
  .list-dl dd, .stacks dd { margin: 0; color: var(--ink-2); }
  .stacks dt { color: var(--blue-ink); }
  @media (max-width: 860px) { .two { grid-template-columns: minmax(0, 1fr); } }
  .builds { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; margin-top: clamp(32px, 4vw, 56px); background: var(--line-night); border: 1px solid var(--line-night); border-radius: var(--radius-l); overflow: hidden; }
  .builds li { background: var(--night); padding: 28px; display: grid; gap: 10px; align-content: start; }
  .builds .n { color: var(--ink-inverse-2); }
  .builds .small { color: var(--ink-inverse-2); }
  .builds .k { color: var(--sky); }
  @media (max-width: 900px) { .builds { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .builds { grid-template-columns: minmax(0, 1fr); } }
  .outcomes { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-top: clamp(32px, 4vw, 56px); }
  @media (max-width: 960px) { .outcomes { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .outcomes { grid-template-columns: minmax(0, 1fr); } }
</style>

<script>
  const rot = document.querySelector<HTMLElement>('[data-rotator]');
  if (rot && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const words = [...rot.children] as HTMLElement[];
    let i = 0;
    rot.classList.add('is-ready');
    words[0].classList.add('is-on');
    setInterval(() => {
      words[i].classList.remove('is-on');
      i = (i + 1) % words.length;
      words[i].classList.add('is-on');
    }, 2400);
  }
</script>
