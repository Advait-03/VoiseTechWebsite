---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LogoMark from '../../components/LogoMark.astro';
import CtaBand from '../../components/CtaBand.astro';
import Img from '../../components/Img.astro';
import Icon from '../../components/Icon.astro';
import { allCaseStudies, formatDate, type CaseStudy } from '../../lib/content';
import { publisherLogoNames } from '../../data/publisher-logos';

export async function getStaticPaths() {
  const all = await allCaseStudies();
  return all.map((c, i) => ({ params: { slug: c.id }, props: { cs: c, prev: all[i + 1], next: all[i - 1] } }));
}
type Props = { cs: CaseStudy; prev?: CaseStudy; next?: CaseStudy };
const { cs, prev, next } = Astro.props;
const { Content } = await render(cs);
const d = cs.data;
// Short numeric values ("24.1 million", "0.74%") become headline figures; longer
// values ("25-45 Men- Female-Lifestyle…") are shown as text facts.
const numeric = d.metrics.filter((m) => m.value.length <= 16 && /^[~<>]?\s*[\d.,]/.test(m.value));
const textual = d.metrics.filter((m) => !numeric.includes(m));
const crumbs = [{ label: 'Resources', href: '/resources/blog/' }, { label: 'Case Studies', href: '/resources/case-studies/' }, { label: d.title, href: `/case-study/${cs.id}/` }];
const schema = [{ '@type': 'Article', headline: d.title, description: d.description, datePublished: d.date.toISOString(), dateModified: (d.updated ?? d.date).toISOString(), image: d.image ? new URL(d.image.src, Astro.site).href : undefined, publisher: { '@id': 'https://www.voisetech.com/#organization' }, articleSection: 'Case study' }];
---
<BaseLayout title={d.seoTitle ?? d.title} description={d.description || d.excerpt} type="article" image={d.image} publishedTime={d.date} modifiedTime={d.updated} breadcrumbs={crumbs.slice(1)} schema={schema}>
  <header class="head container">
    <Breadcrumbs items={crumbs} />
    <p class="eyebrow" data-reveal>Case study</p>
    <h1 class="h1 title" data-reveal style="--i:1">{d.title}</h1>
    {d.description && <p class="lede" data-reveal style="--i:2">{d.description}</p>}
  </header>

  {d.metrics.length > 0 && (
    <section class="results on-night" aria-labelledby="results-title">
      <div class="container">
        <h2 id="results-title" class="mono r-title">Metric results</h2>
        <dl class="numbers" style={`--n:${Math.max(numeric.length, 1)}`} data-stagger>
          {numeric.map((m) => (
            <div data-reveal><dd class="tnum">{m.value}</dd><dt>{m.label}</dt></div>
          ))}
        </dl>
        {textual.length > 0 && (
          <dl class="facts">
            {textual.map((m) => <div><dt class="mono">{m.label}</dt><dd>{m.value}</dd></div>)}
          </dl>
        )}
      </div>
    </section>
  )}

  {(d.banner ?? d.image) && (
    <div class="container banner" data-reveal="mask">
      <div class="media"><Img src={(d.banner ?? d.image)!.src} alt={`${d.title} - campaign creative`} sizes="(max-width: 1280px) 100vw, 1280px" /></div>
    </div>
  )}

  <article class="container body">
    <div class="prose"><Content /></div>
    {d.publishers.length > 0 && (
      <section class="pubs" aria-labelledby="pubs-title">
        <h2 id="pubs-title" class="h4">Publishers</h2>
        <ul role="list">
          {d.publishers.map((src) => <li><LogoMark src={src} name={publisherLogoNames[src] ?? 'Publisher'} area={2600} maxHeight={46} maxWidth={130} /></li>)}
        </ul>
      </section>
    )}
    <p class="published mono">Published {formatDate(d.date)}</p>
  </article>

  <nav class="container pager" aria-label="More case studies">
    {prev ? <a class="pg prev" href={`/case-study/${prev.id}/`}><span class="mono">Previous</span><span>{prev.data.title}</span></a> : <span></span>}
    {next ? <a class="pg next" href={`/case-study/${next.id}/`}><span class="mono">Next</span><span>{next.data.title}</span></a> : <span></span>}
  </nav>

  <CtaBand eyebrow="Work with us" title="Let’s Build What’s Next in Programmatic Advertising - Together." primary={{ label: d.cta?.label ?? 'Connect With Us Today', href: d.cta?.href ?? '/contact-us/' }} secondary={{ label: 'All case studies', href: '/resources/case-studies/' }} />
</BaseLayout>

<style>
  .head { display: grid; gap: 20px; padding-block: clamp(40px, 6vw, 88px) clamp(40px, 5vw, 64px); }
  .title { max-width: 24ch; font-size: clamp(2.2rem, 1.4rem + 3vw, 4rem); }
  .head .lede { max-width: 60ch; }
  .results { padding-block: clamp(40px, 5vw, 64px); }
  .r-title { color: var(--ink-inverse-2); margin-bottom: 24px; }
  .numbers { display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); border-top: 1px solid var(--line-night); }
  .numbers div { display: grid; gap: 6px; padding: 24px 20px 6px 0; }
  .numbers div + div { padding-left: 20px; border-left: 1px solid var(--line-night); }
  .numbers dd { margin: 0; font-size: clamp(2rem, 1.4rem + 2.2vw, 3.5rem); font-weight: 600; letter-spacing: -0.045em; line-height: 1; background: linear-gradient(90deg, #fff, #cfe6ff); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .numbers dt { color: var(--ink-inverse-2); font-size: var(--fs-small); }
  .facts { display: grid; gap: 12px; margin-top: 28px; padding-top: 22px; border-top: 1px solid var(--line-night); }
  .facts div { display: grid; grid-template-columns: 160px 1fr; gap: 16px; }
  .facts dt { color: var(--sky); }
  .facts dd { margin: 0; color: var(--ink-inverse); }
  @media (max-width: 760px) { .numbers { grid-template-columns: repeat(2, minmax(0, 1fr)); } .numbers div:nth-child(odd) { padding-left: 0; border-left: 0; } .facts div { grid-template-columns: minmax(0, 1fr); gap: 2px; } }
  .banner { margin-top: clamp(40px, 5vw, 72px); }
  .banner .media { aspect-ratio: 1181 / 400; border-radius: var(--radius-l); }
  .body { max-width: 820px; padding-block: clamp(48px, 6vw, 88px) clamp(32px, 4vw, 56px); }
  .pubs { margin-top: 56px; padding-top: 28px; border-top: 1px solid var(--line); }
  .pubs ul { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 18px; }
  .pubs li { display: grid; place-items: center; width: 160px; height: 84px; border: 1px solid var(--line); border-radius: var(--radius); background: #fff; }
  .pubs :global(.logo-mark) { mix-blend-mode: multiply; }
  .published { margin-top: 40px; color: var(--ink-3); }
  .pager { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; padding-bottom: var(--section); }
  .pg { display: grid; gap: 6px; padding: 22px 24px; border: 1px solid var(--line); border-radius: var(--radius); transition: border-color var(--dur), background-color var(--dur); }
  .pg:hover { border-color: var(--ink); background: var(--bg-subtle); }
  .pg .mono { color: var(--ink-3); }
  .pg span:last-child { font-weight: 550; letter-spacing: -0.01em; }
  .next { text-align: right; }
  @media (max-width: 640px) { .pager { grid-template-columns: minmax(0, 1fr); } .next { text-align: left; } }
</style>
