---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const entry = (await getEntry('legal', 'privacy-policy'))!;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
---
<BaseLayout
  title="Privacy Policy | Voise Tech"
  description={entry.data.description}
  breadcrumbs={[{ label: 'Privacy Policy', href: '/privacy-policy/' }]}
>
  <div class="progress" aria-hidden="true"><span data-progress></span></div>
  <header class="head container">
    <Breadcrumbs items={[{ label: 'Privacy Policy', href: '/privacy-policy/' }]} />
    <p class="eyebrow">Legal</p>
    <h1 class="h1">{entry.data.title}</h1>
    <p class="meta mono">Effective {entry.data.effective} · Last updated {entry.data.updated}</p>
  </header>
  <div class="container layout" data-progress-target>
    <nav class="toc" aria-label="Sections" data-section-nav>
      <p class="mono toc-title">Sections</p>
      <ol role="list">{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text.replace(/\\/g, '')}</a></li>)}</ol>
    </nav>
    <article class="prose legal"><Content /></article>
  </div>
</BaseLayout>

<style>
  .progress { position: fixed; inset: 0 0 auto 0; height: 3px; z-index: 120; pointer-events: none; }
  .progress span { display: block; height: 100%; background: var(--grad); transform-origin: left; transform: scaleX(0); }
  .head { display: grid; gap: 18px; padding-block: clamp(40px, 6vw, 88px) clamp(32px, 4vw, 56px); border-bottom: 1px solid var(--line); }
  .head h1 { max-width: 20ch; font-size: clamp(2.2rem, 1.5rem + 2.8vw, 4rem); }
  .meta { color: var(--ink-2); }
  .layout { display: grid; grid-template-columns: 260px minmax(0, 760px); gap: clamp(32px, 6vw, 96px); padding-block: clamp(40px, 5vw, 72px) var(--section); justify-content: center; }
  .toc { position: sticky; top: 100px; align-self: start; max-height: calc(100vh - 140px); overflow-y: auto; }
  .toc-title { color: var(--ink-3); margin-bottom: 12px; }
  .toc ol { border-left: 1px solid var(--line); }
  .toc a { display: block; padding: 5px 0 5px 14px; margin-left: -1px; border-left: 1px solid transparent; font-size: var(--fs-xs); color: var(--ink-2); }
  .toc a:hover { color: var(--ink); }
  .toc a[aria-current] { color: var(--ink); border-left-color: var(--blue); }
  .legal { font-size: 1.02rem; }
  .legal :global(h2) { scroll-margin-top: 100px; }
  @media (max-width: 960px) { .layout { grid-template-columns: minmax(0, 1fr); } .toc { position: static; max-height: none; } }
</style>
