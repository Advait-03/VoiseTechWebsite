---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import StackMap from './StackMap.astro';
import AuctionDemo from './AuctionDemo.astro';
import SectionHeading from './SectionHeading.astro';
import CtaBand from './CtaBand.astro';
import Icon from './Icon.astro';
import Img from './Img.astro';
import products from '../data/products.json';
import { productImages } from '../data/product-media';
import { platformProduct, publisherProducts, buyerProducts } from '../data/navigation';

// Optional per-product section copy (only the platform entry sets these today).
type Extras = { edgeEyebrow?: string; edgeTitle?: string; integrationsEyebrow?: string; featuresTitle?: string; techEyebrow?: string; techTitle?: string };
type Product = (typeof products)[number] & Extras;
interface Props { product: Product }
const { product: p } = Astro.props;

const isPlatform = p.category === 'platform';
const isPublisher = p.category === 'publishers';
const categoryHref = isPlatform ? '/products/' : isPublisher ? '/ad-publishers-solutions/' : '/ad-buyers-solutions/';
const categoryLabel = isPublisher ? 'Publishers' : 'Buyers';
const crumbs = isPlatform
  ? [{ label: 'Products', href: '/products/' }, { label: p.name, href: `/${p.slug}/` }]
  : [{ label: 'Products', href: '/products/' }, { label: categoryLabel, href: categoryHref }, { label: p.name, href: `/${p.slug}/` }];
// Every product links back to the platform it runs alongside.
const others = isPlatform
  ? publisherProducts
  : [platformProduct, ...(isPublisher ? publisherProducts : buyerProducts)].filter((l) => l.href !== `/${p.slug}/`);

const sections = [
  { id: 'overview', label: 'Overview', show: true },
  { id: 'edge', label: p.edgeEyebrow ?? 'Your edge', show: !!p.edge?.length },
  { id: 'integrations', label: p.integrationsEyebrow ?? p.integrationsTitle ?? 'Integrations', show: !!p.integrations?.length },
  { id: 'auction', label: 'Auction demo', show: isPlatform },
  { id: 'features', label: 'Features', show: !!p.features?.length },
  { id: 'technology', label: p.techEyebrow ?? 'Technology', show: !!p.tech?.length },
  { id: 'use-cases', label: 'Use cases', show: !!p.useCases?.length },
  { id: 'compliance', label: p.complianceTitle ?? 'Compliance', show: !!p.compliance?.length },
  { id: 'why', label: 'Why Voise', show: !!p.why?.length },
].filter((s) => s.show);

const schema = [{
  '@type': 'Product',
  name: p.name,
  description: p.description || p.intro[0],
  brand: { '@type': 'Brand', name: 'Voise Tech' },
  category: isPlatform ? 'Ad server' : isPublisher ? 'Publisher advertising technology' : 'Buyer advertising technology',
  url: new URL(`/${p.slug}/`, Astro.site).href,
}];
const og = p.ogImage && !p.ogImage.endsWith('.svg') ? { src: p.ogImage } : undefined;
---
<BaseLayout
  title={p.seoTitle}
  description={p.description}
  image={og}
  modifiedTime={p.modifiedTime ? new Date(p.modifiedTime) : undefined}
  breadcrumbs={crumbs}
  schema={schema}
>
  <PageHero
    eyebrow={isPlatform ? 'Core platform' : isPublisher ? 'Publisher product' : 'Buyer product'}
    title={p.name}
    crumbs={crumbs}
    split
  >
    <p class="tagline grad-text" data-reveal style="--i:2">{p.tagline}</p>
    <div class="intro" data-reveal style="--i:3">
      {p.intro.map((t) => <p>{t}</p>)}
    </div>
    <div class="cluster" slot="actions">
      {p.heroCta && <a class="btn" href={p.heroCta.href}>{p.heroCta.label}<Icon name="arrow" size={16} class="arrow" /></a>}
      <a class="btn btn-secondary" href={categoryHref}>{isPlatform ? 'All products' : `All ${categoryLabel.toLowerCase()} products`}</a>
    </div>
    <div slot="visual" class="hero-visual">
      <StackMap current={p.slug} />
      <p class="visual-caption mono">{isPlatform ? 'Every Voise product connects through the AdServer' : `Where ${p.name} fits in the Voise ecosystem`}</p>
    </div>
  </PageHero>

  <div class="product-body">
  {sections.length > 2 && (
    <nav class="subnav" aria-label={`${p.name} sections`} data-section-nav>
      <div class="container subnav-inner">
        <span class="subnav-title">{p.name}</span>
        <ul role="list">
          {sections.map((s) => <li><a href={`#${s.id}`}>{s.label}</a></li>)}
        </ul>
        {p.heroCta && <a class="btn btn-sm" href={p.heroCta.href}>{p.heroCta.label}</a>}
      </div>
    </nav>
  )}

  <div id="overview" class="anchor"></div>

  {p.edge?.length > 0 && (
    <section class="section on-night edge" id="edge">
      <div class="container">
        <SectionHeading eyebrow={p.edgeEyebrow ?? 'Your edge'} title={p.edgeTitle ?? 'Your Edge with Voise Tech.'} />
        <ol role="list" class="edge-grid" data-stagger style={`--n:${p.edge.length}`}>
          {p.edge.map((e: { title: string; text?: string; status?: string }, i) => (
            <li data-reveal data-glow>
              <span class="mono edge-n">0{i + 1}</span>
              <h3 class="h4">{e.title}</h3>
              {e.text && <p>{e.text}</p>}
              {e.status && <span class="status mono">{e.status}</span>}
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {p.integrations?.length > 0 && (
    <section class="section tone-subtle" id="integrations">
      <div class="container">
        <SectionHeading eyebrow={p.integrationsEyebrow ?? (p.integrationsTitle === 'Supported Formats' ? 'Formats' : 'Ecosystem')} title={`${p.integrationsTitle}.`} />
        <ol role="list" class="int-grid" data-stagger>
          {p.integrations.map((it, i) => (
            <li data-reveal>
              <span class="mono int-n">0{i + 1}</span>
              <h3 class="h4">{it.label}</h3>
              <p class="muted">{it.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {isPlatform && (
    <section class="section" id="auction">
      <div class="container two-col">
        <div class="sticky-head">
          <SectionHeading eyebrow="See it work" title="Watch an Auction." lede="An illustration of one decision inside Voise AdServer. The ad request sets the floor and the timeout; demand partners bid through their line items; late bids, bids under the floor and blocked advertiser domains drop out; the highest eligible bid wins." />
          <ul role="list" class="rules mono" data-reveal>
            <li><span class="rule-k is-bid"></span>Eligible bid</li>
            <li><span class="rule-k is-win"></span>Winning bid</li>
            <li><span class="rule-k is-out"></span>Timed out, below floor or blocked</li>
          </ul>
        </div>
        <div data-reveal="fade"><AuctionDemo /></div>
      </div>
    </section>
  )}

  {p.features?.length > 0 && (
    <section class="section" id="features">
      <div class="container two-col">
        <div class="sticky-head">
          <SectionHeading eyebrow="Capabilities" title={p.featuresTitle ?? 'What Sets Us Apart'} />
        </div>
        <div class="accordion" data-stagger>
          {p.features.map((f, i) => (
            <details class="acc" name={`features-${p.slug}`} open={i === 0} data-reveal>
              <summary>
                <span class="mono acc-n">0{i + 1}</span>
                <span class="acc-title">{f.title}</span>
                <span class="acc-icon" aria-hidden="true"><Icon name="plus" size={18} /></span>
              </summary>
              <dl class="acc-body">
                {f.items.map((it) => (
                  <div>
                    {it.label && <dt>{it.label}</dt>}
                    <dd>{it.text}</dd>
                  </div>
                ))}
              </dl>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  {p.tech?.length > 0 && (
    <section class="section tone-subtle" id="technology">
      <div class="container two-col">
        <div class="sticky-head">
          <SectionHeading eyebrow={p.techEyebrow ?? 'Technology'} title={p.techTitle ?? 'Smarter Tech, Stronger Results.'} lede={p.techIntro} />
        </div>
        <ul role="list" class="tech-list" data-stagger>
          {p.tech.map((t, i) => (
            <li data-reveal>
              <span class="tech-icon">{t.icon ? <img src={t.icon} alt="" width="28" height="28" loading="lazy" decoding="async" /> : <span class="mono">0{i + 1}</span>}</span>
              <span class="tech-label mono">{t.label}</span>
              <span class="tech-value">{t.value}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {p.useCases?.length > 0 && (
    <section class="section" id="use-cases">
      <div class="container">
        <SectionHeading eyebrow="Use cases" title="Use Cases." />
        <ul role="list" class="uc-grid" data-stagger>
          {p.useCases.map((u) => (
            <li data-reveal class="card">
              {u.icon && <img src={u.icon} alt="" width="52" height="52" loading="lazy" decoding="async" class="uc-icon" />}
              {u.title && <h3 class="h4">{u.title}</h3>}
              <p class:list={[u.title ? 'muted small' : 'uc-solo']}>{u.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {p.compliance?.length > 0 && (
    <section class:list={['section', p.useCases?.length ? 'tone-subtle' : '']} id="compliance">
      <div class="container two-col">
        <SectionHeading eyebrow="Trust" title={p.complianceTitle} />
        <ul role="list" class="check-list" data-stagger>
          {p.compliance.map((c) => <li data-reveal><span class="check"><Icon name="check" size={16} stroke={2} /></span>{c.text}</li>)}
        </ul>
      </div>
    </section>
  )}

  {p.why?.length > 0 && (
    <section class="section" id="why">
      <div class="container two-col">
        <SectionHeading eyebrow="Why Voise" title={p.whyTitle} />
        <ul role="list" class="why-list" data-stagger>
          {p.why.map((w, i) => <li data-reveal><span class="mono">0{i + 1}</span>{w}</li>)}
        </ul>
      </div>
    </section>
  )}

  </div>

  {p.closing && (
    <CtaBand
      eyebrow={p.name}
      title={p.closing.heading}
      primary={{ label: p.closing.cta.label, href: p.closing.cta.href }}
      secondary={{ label: 'Talk to our team', href: '/contact-us/' }}
    />
  )}

  <section class="section">
    <div class="container">
      <div class="others-head">
        <SectionHeading eyebrow={isPlatform ? 'Around the platform' : `More for ${categoryLabel.toLowerCase()}`} title={isPlatform ? 'Publisher Products.' : 'Other Products.'} />
        <a class="link-arrow" href="/products/"><span class="label">All products</span><Icon name="arrow" size={14} class="arrow" /></a>
      </div>
      <ul role="list" class="others" data-stagger>
        {others.map((o) => {
          const slug = o.href.replaceAll('/', '');
          return (
            <li data-reveal>
              <a class="other-card is-link" href={o.href}>
                <div class="media" style="aspect-ratio: 4/3">
                  {productImages[slug] && <Img src={productImages[slug]} alt="" sizes="(max-width: 860px) 100vw, 30vw" />}
                </div>
                <h3 class="h4">{o.label}</h3>
                <p class="muted small">{o.description}</p>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .tagline { font-size: clamp(1.35rem, 1.1rem + 1vw, 2rem); font-weight: 600; letter-spacing: -0.03em; line-height: 1.2; }
  .intro { display: grid; gap: 14px; color: var(--ink-2); max-width: 60ch; }
  .hero-visual { display: grid; gap: 12px; }
  .visual-caption { color: var(--ink-3); text-align: center; font-size: 0.68rem; }

  .subnav { position: sticky; top: 0; z-index: 90; background: rgb(255 255 255 / 0.9); backdrop-filter: saturate(1.5) blur(14px); -webkit-backdrop-filter: saturate(1.5) blur(14px); border-block: 1px solid var(--line); }
  .subnav-inner { display: flex; align-items: center; gap: 24px; height: 60px; }
  .subnav-title { font-weight: 600; letter-spacing: -0.02em; white-space: nowrap; }
  .subnav ul { display: flex; gap: 4px; overflow-x: auto; scrollbar-width: none; flex: 1; }
  .subnav ul::-webkit-scrollbar { display: none; }
  .subnav li a { display: block; padding: 8px 12px; border-radius: 999px; font-size: var(--fs-small); color: var(--ink-2); white-space: nowrap; transition: color var(--dur), background-color var(--dur); }
  .subnav li a:hover { color: var(--ink); background: var(--bg-muted); }
  .subnav li a[aria-current] { color: var(--ink); background: var(--bg-muted); }
  .subnav .btn { flex: none; }
  @media (max-width: 860px) { .subnav-title, .subnav .btn { display: none; } }
  .anchor { scroll-margin-top: 140px; }
  section[id] { scroll-margin-top: 80px; }

  .two-col { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .sticky-head { position: sticky; top: 110px; }
  @media (max-width: 900px) { .two-col { grid-template-columns: minmax(0, 1fr); } .sticky-head { position: static; } }

  .rules { display: grid; gap: 10px; margin-top: 28px; font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-2); }
  .rules li { display: flex; align-items: center; gap: 10px; }
  .rule-k { width: 28px; height: 10px; border-radius: 999px; background: var(--blue); }
  .rule-k.is-win { background: var(--green); }
  .rule-k.is-out { background: repeating-linear-gradient(45deg, var(--line-strong) 0 3px, var(--bg-muted) 3px 7px); }

  .tech-list { border-top: 1px solid var(--line); }
  .tech-list li { display: grid; grid-template-columns: 44px minmax(120px, 0.6fr) minmax(0, 1fr); gap: 18px; align-items: center; padding: 20px 0; border-bottom: 1px solid var(--line); }
  .tech-icon { width: 44px; height: 44px; border-radius: 12px; background: linear-gradient(135deg, var(--blue), #0b5aa0 55%, #0a7f43); display: grid; place-items: center; box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12); }
  .tech-icon .mono { color: #fff; }
  .tech-icon img { width: 26px; height: 26px; object-fit: contain; }
  .tech-label { color: var(--ink-2); }
  .tech-value { font-weight: 500; letter-spacing: -0.01em; }
  @media (max-width: 560px) { .tech-list li { grid-template-columns: 44px 1fr; } .tech-value { grid-column: 2; } }

  .edge-grid { display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 1px; margin-top: clamp(36px, 5vw, 64px); background: var(--line-night); border: 1px solid var(--line-night); border-radius: var(--radius-l); overflow: hidden; }
  .edge-grid li { position: relative; background: var(--night); padding: clamp(24px, 2.6vw, 36px); display: grid; gap: 14px; align-content: start; min-height: 220px; }
  .edge-grid li::before { content: ''; position: absolute; inset: 0; background: radial-gradient(300px circle at var(--mx, 50%) var(--my, 0%), rgb(95 180 255 / 0.12), transparent 60%); opacity: 0; transition: opacity var(--dur); pointer-events: none; }
  .edge-grid li:hover::before { opacity: 1; }
  .edge-n { color: var(--sky); }
  .edge-grid .status { justify-self: start; margin-top: auto; padding: 4px 10px; border-radius: 999px; border: 1px solid rgb(255 255 255 / 0.22); color: var(--ink-inverse-2); font-size: 0.66rem; letter-spacing: 0.06em; text-transform: uppercase; }
  .edge-grid h3 { font-weight: 550; }
  .edge-grid p { color: var(--ink-inverse-2); font-size: var(--fs-small); }
  @media (max-width: 1000px) { .edge-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .edge-grid { grid-template-columns: minmax(0, 1fr); } .edge-grid li { min-height: 0; } }

  .accordion { border-top: 1px solid var(--line); }
  .acc { border-bottom: 1px solid var(--line); }
  .acc summary { list-style: none; display: grid; grid-template-columns: 44px 1fr 32px; align-items: center; gap: 12px; padding: 24px 0; cursor: pointer; }
  .acc summary::-webkit-details-marker { display: none; }
  .acc-n { color: var(--blue-ink); }
  .acc-title { font-size: clamp(1.1rem, 1rem + 0.4vw, 1.35rem); font-weight: 600; letter-spacing: -0.02em; }
  .acc-icon { width: 32px; height: 32px; border-radius: 50%; border: 1px solid var(--line-strong); display: grid; place-items: center; transition: transform var(--dur) var(--ease-out), background-color var(--dur), color var(--dur); }
  .acc summary:hover .acc-icon { background: var(--ink); color: #fff; border-color: var(--ink); }
  .acc[open] .acc-icon { transform: rotate(45deg); }
  .acc-body { display: grid; gap: 14px; padding: 0 44px 28px 56px; }
  .acc-body div { display: grid; grid-template-columns: minmax(120px, 0.45fr) 1fr; gap: 16px; }
  .acc-body dt { font-weight: 600; font-size: var(--fs-small); }
  .acc-body dd { color: var(--ink-2); font-size: var(--fs-small); margin: 0; }
  .acc-body div:has(dt:only-child) , .acc-body div:not(:has(dt)) { grid-template-columns: minmax(0, 1fr); }
  @media (prefers-reduced-motion: no-preference) { .acc[open] .acc-body { animation: acc-in 420ms var(--ease-out); } }
  @keyframes acc-in { from { opacity: 0; transform: translateY(-6px); } }
  @media (max-width: 560px) { .acc-body { padding-left: 0; padding-right: 0; } .acc-body div { grid-template-columns: minmax(0, 1fr); gap: 2px; } }

  .int-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; margin-top: clamp(36px, 5vw, 56px); border-top: 1px solid var(--line-strong); }
  .int-grid li { padding: 26px 22px 6px 0; display: grid; gap: 10px; align-content: start; }
  .int-grid li + li { padding-left: 22px; border-left: 1px solid var(--line); }
  .int-n { color: var(--blue-ink); }
  @media (max-width: 900px) { .int-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .int-grid li:nth-child(3) { padding-left: 0; border-left: 0; } .int-grid li:nth-child(n + 3) { border-top: 1px solid var(--line); margin-top: 18px; } }
  @media (max-width: 520px) { .int-grid { grid-template-columns: minmax(0, 1fr); } .int-grid li { padding-left: 0 !important; border-left: 0 !important; } .int-grid li + li { border-top: 1px solid var(--line); } }

  .uc-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-top: clamp(32px, 4vw, 56px); }
  .uc-grid li { padding: 26px; display: grid; gap: 12px; align-content: start; }
  .uc-icon { width: 52px; height: 52px; object-fit: contain; padding: 12px; border-radius: 14px; background: linear-gradient(135deg, var(--blue), #0b5aa0 55%, #0a7f43); margin-bottom: 10px; }
  .uc-solo { font-weight: 550; letter-spacing: -0.01em; }
  @media (max-width: 960px) { .uc-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .uc-grid { grid-template-columns: minmax(0, 1fr); } }

  .check-list, .why-list { border-top: 1px solid var(--line); }
  .check-list li, .why-list li { display: flex; gap: 16px; align-items: center; padding: 22px 0; border-bottom: 1px solid var(--line); font-size: clamp(1.05rem, 1rem + 0.25vw, 1.2rem); font-weight: 500; letter-spacing: -0.012em; }
  .check { width: 32px; height: 32px; border-radius: 50%; background: var(--blue-soft); color: var(--blue-ink); display: grid; place-items: center; flex: none; }
  .why-list li .mono { color: var(--blue-ink); flex: none; width: 32px; }

  .others-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; flex-wrap: wrap; margin-bottom: clamp(32px, 4vw, 48px); }
  .others { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: clamp(20px, 2.5vw, 32px); }
  .other-card { display: grid; gap: 12px; }
  .other-card:hover h3 { color: var(--blue-ink); }
</style>
