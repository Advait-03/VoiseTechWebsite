---
/** Hero used by inner pages: breadcrumb, eyebrow, H1, lede and actions, with an optional visual. */
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lede?: string | string[];
  crumbs?: { label: string; href: string }[];
  variant?: 'light' | 'night';
  /** Split layout with the `visual` slot on the right (desktop). */
  split?: boolean;
}
const { eyebrow, title, lede, crumbs = [], variant = 'light', split = false } = Astro.props;
const ledes = Array.isArray(lede) ? lede : lede ? [lede] : [];
const hasVisual = Astro.slots.has('visual');
---
<section class:list={['page-hero', variant === 'night' && 'on-night', split && hasVisual && 'is-split']}>
  <div class="bg" aria-hidden="true"></div>
  <div class="container inner">
    <div class="copy">
      {crumbs.length > 0 && <Breadcrumbs items={crumbs} />}
      {eyebrow && <p class="eyebrow" data-reveal>{eyebrow}</p>}
      <h1 class="h1 title" data-reveal style="--i:1"><Fragment set:html={title} /></h1>
      {ledes.map((p, i) => <p class:list={[i === 0 ? 'lede' : 'muted body']} data-reveal style={`--i:${2 + i}`}>{p}</p>)}
      <slot />
      {Astro.slots.has('actions') && <div class="actions" data-reveal style="--i:4"><slot name="actions" /></div>}
    </div>
    {hasVisual && <div class="visual" data-reveal="fade" style="--i:2"><slot name="visual" /></div>}
  </div>
</section>

<style>
  .page-hero { position: relative; padding-block: clamp(48px, 7vw, 104px) clamp(64px, 8vw, 120px); overflow: hidden; isolation: isolate; }
  .bg {
    position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(60% 70% at 92% 0%, rgb(8 112 199 / 0.08), transparent 70%),
      radial-gradient(40% 50% at 70% 20%, rgb(14 177 81 / 0.06), transparent 70%);
  }
  .bg::after {
    content: ''; position: absolute; inset: 0;
    background-image: linear-gradient(to right, rgb(23 25 29 / 0.05) 1px, transparent 1px), linear-gradient(to bottom, rgb(23 25 29 / 0.05) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(70% 80% at 85% 10%, #000, transparent 75%);
  }
  .on-night .bg { background: radial-gradient(60% 70% at 90% 0%, rgb(8 112 199 / 0.35), transparent 70%), radial-gradient(50% 60% at 10% 100%, rgb(14 177 81 / 0.16), transparent 70%); }
  .on-night .bg::after { background-image: linear-gradient(to right, rgb(255 255 255 / 0.05) 1px, transparent 1px), linear-gradient(to bottom, rgb(255 255 255 / 0.05) 1px, transparent 1px); }
  .inner { display: grid; gap: 48px; }
  .copy { display: grid; gap: 22px; align-content: start; max-width: 880px; }
  .title { margin-top: 6px; }
  .copy :global(.crumbs) { margin-bottom: 18px; }
  .body { max-width: 62ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 10px; }
  .is-split .inner { grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); align-items: center; }
  @media (max-width: 960px) { .is-split .inner { grid-template-columns: minmax(0, 1fr); } }
</style>
