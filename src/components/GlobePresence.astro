---
/**
 * Globe with a flag planted in each office country (justdice-style).
 * Artwork and pin positions come from scripts/make-globe.mjs; re-run it if the offices change.
 */
const offices = [
  { name: 'USA', x: 10.91, y: 23.04, flag: 'us' },
  { name: 'UK', x: 45.02, y: 29.24, flag: 'uk' },
  { name: 'UAE', x: 82.81, y: 46.86, flag: 'ae', flip: true },
  { name: 'India', x: 93.51, y: 41.74, flag: 'in', flip: true, tall: true },
];
---
<figure class="globe" aria-label="VoiseTech offices: USA, UK, UAE and India">
  <div class="sphere">
    <img src="/brand/globe.svg" alt="" width="1000" height="1000" loading="lazy" decoding="async" />
    <ul role="list" class="flags" aria-hidden="true">
      {offices.map((o, i) => (
        <li class:list={[o.flip && 'flip', o.tall && 'tall']} style={`left:${o.x}%;top:${o.y}%;--d:${i * -0.7}s`}>
          <span class="pole"></span>
          <svg class="flag" viewBox="0 0 60 40">
            {o.flag === 'us' && <>
              <rect width="60" height="40" fill="#b22234" />
              {[1, 3, 5, 7, 9, 11].map((s) => <rect y={s * 40 / 13} width="60" height={40 / 13} fill="#fff" />)}
              <rect width="26" height={40 * 7 / 13} fill="#3c3b6e" />
              {[0, 1, 2].map((r) => [0, 1, 2, 3].map((c) => <circle cx={4 + c * 6 + (r % 2) * 3} cy={4 + r * 6.5} r="1.1" fill="#fff" />))}
            </>}
            {o.flag === 'uk' && <>
              <rect width="60" height="40" fill="#012169" />
              <path d="M0 0L60 40M60 0L0 40" stroke="#fff" stroke-width="8" />
              <path d="M0 0L60 40M60 0L0 40" stroke="#c8102e" stroke-width="2.6" />
              <path d="M30 0V40M0 20H60" stroke="#fff" stroke-width="12" />
              <path d="M30 0V40M0 20H60" stroke="#c8102e" stroke-width="7" />
            </>}
            {o.flag === 'ae' && <>
              <rect width="60" height="40" fill="#fff" />
              <rect width="60" height="13.4" fill="#00732f" />
              <rect y="26.6" width="60" height="13.4" fill="#000" />
              <rect width="16" height="40" fill="#ff0000" />
            </>}
            {o.flag === 'in' && <>
              <rect width="60" height="40" fill="#fff" />
              <rect width="60" height="13.4" fill="#ff9933" />
              <rect y="26.6" width="60" height="13.4" fill="#138808" />
              <circle cx="30" cy="20" r="5" fill="none" stroke="#000080" stroke-width="1.2" />
              <circle cx="30" cy="20" r="1" fill="#000080" />
            </>}
          </svg>
          <span class="label mono">{o.name}</span>
        </li>
      ))}
    </ul>
  </div>
</figure>

<style>
  /* Bottom of the sphere is cropped, flags may overflow the top and sides. */
  .globe { margin: 0; clip-path: inset(-30% -30% 22% -30%); margin-bottom: -22%; }
  .sphere { position: relative; aspect-ratio: 1; }
  .sphere > img { width: 100%; height: 100%; filter: drop-shadow(0 30px 60px rgb(11 37 69 / 0.18)); }
  .flags li { position: absolute; width: 0; height: 0; --pole: clamp(54px, 9vw, 96px); }
  .flags li.tall { --pole: clamp(80px, 13vw, 140px); }
  .pole { position: absolute; left: -1.5px; bottom: 0; width: 3px; height: var(--pole); border-radius: 2px; background: linear-gradient(90deg, #8fb6dd, #3a78b8); }
  .pole::before { content: ''; position: absolute; top: -5px; left: -2px; width: 7px; height: 7px; border-radius: 50%; background: #3a78b8; }
  .pole::after { content: ''; position: absolute; bottom: -3px; left: -3px; width: 9px; height: 5px; border-radius: 50%; background: rgb(11 37 69 / 0.35); }
  .flag { position: absolute; left: 1px; bottom: calc(var(--pole) - clamp(26px, 4vw, 40px)); width: clamp(40px, 6vw, 60px); max-width: none; height: clamp(26px, 4vw, 40px); border-radius: 2px; box-shadow: 0 6px 14px rgb(11 37 69 / 0.25); transform-origin: left center; }
  .flip .flag { left: auto; right: 1px; transform-origin: right center; }
  .flip .label { left: auto; right: 8px; }
  .label { position: absolute; left: 8px; bottom: -26px; white-space: nowrap; font-size: 0.68rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: 2px 8px; box-shadow: var(--shadow-soft); }
  @media (max-width: 600px) { .label { display: none; } }
  @media (prefers-reduced-motion: no-preference) {
    .flag { animation: wave 2.8s var(--ease-in-out) infinite alternate; animation-delay: var(--d); }
    @keyframes wave { 0% { transform: perspective(200px) rotateY(0deg) skewY(0deg); } 100% { transform: perspective(200px) rotateY(-18deg) skewY(-4deg); } }
    .flip .flag { animation-name: wave-flip; }
    @keyframes wave-flip { 0% { transform: perspective(200px) rotateY(0deg) skewY(0deg); } 100% { transform: perspective(200px) rotateY(18deg) skewY(4deg); } }
    .sphere { animation: float 8s var(--ease-in-out) infinite alternate; }
    @keyframes float { to { translate: 0 -10px; } }
  }
</style>
