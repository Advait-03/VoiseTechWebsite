# ─────────────────────────────────────────────────────────────────────────────
# VoiseTech website — environment configuration
# Copy to `.env` for local development. Never commit real secrets.
# Server values are read at runtime (process.env); PUBLIC_* values are
# inlined into the client bundle at build time.
# ─────────────────────────────────────────────────────────────────────────────

# ── Form delivery (contact, careers, GAM 360 enquiries) ─────────────────────
# SMTP account used to email submissions to the team.
SMTP_HOST=
SMTP_PORT=587
# "true" for implicit TLS (port 465); STARTTLS is used otherwise.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender address (must be allowed by the SMTP account).
MAIL_FROM="VoiseTech Website <no-reply@voisetech.com>"

# Recipients per form (comma-separated). Default: business@voisetech.com
CONTACT_TO=business@voisetech.com
CAREERS_TO=business@voisetech.com
GAM_TO=business@voisetech.com

# smtp  → send email (default when SMTP_HOST is set)
# file  → write submissions + attachments to ./.submissions (local testing only;
#         contains personal data — never enable on a public server)
# Leave empty to auto-select: smtp when configured, file in `astro dev`,
# otherwise the API answers 503 so a submission is never silently dropped.
FORM_DELIVERY=

# ── Spam protection: Google reCAPTCHA v3 (optional) ─────────────────────────
# The live WordPress site uses this site key. The secret must come from the
# Google reCAPTCHA admin console; leave both empty to rely on the honeypot,
# timing check and rate limit only.
PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# ── Analytics (IDs used by the current live site) ───────────────────────────
# Loaded only in production builds. Review consent requirements (UK GDPR /
# PECR) before enabling — see docs/REVIEW-ITEMS.md.
PUBLIC_GTM_ID=GTM-W2VGNH5K
PUBLIC_GA4_ID=G-ZVK4H8B2R3

# ── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=4321
# Requests allowed per IP per form endpoint in a 10-minute window.
FORM_RATE_LIMIT=5
# Set to "true" only when running behind a reverse proxy / load balancer that sets
# X-Forwarded-For; the form rate limiter then keys on the forwarded client IP.
TRUST_PROXY=false
